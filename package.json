{
  "name": "reki",
  "version": "1.0.0",
  "description": "LAN media & text remote control",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "build": "pkg . --target node18-win-x64 --output reki-win.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/@nut-tree-fork/nut-js/dist/**/*",
      "node_modules/@nut-tree-fork/nut-js/build/**/*",
      "node_modules/@nut-tree-fork/nut-js/lib/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "supertest": "^7.0.0"
  }
}
